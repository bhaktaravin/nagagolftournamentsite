# Postgres (Supabase, Neon, RDS, …). Do not commit .env.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Vercel + Supabase tips:
# - Run `npx prisma db push` using the SAME URL as Vercel Production (tables must exist).
# - If you use Supabase "Connection pooling" (port 6543), add `?pgbouncer=true` to DATABASE_URL
#   for Prisma. Keep a direct `db.*.supabase.co:5432` URL for `prisma db push` / migrations only.
# - After deploy, open /api/health/db — { "ok": true } means the server can reach Postgres.

# Optional. Set in production.
JWT_SECRET="your-secret-at-least-32-chars"

# Optional: shared rate limits across instances (Upstash Redis — free tier works).
# https://console.upstash.com/ → create database → REST API → copy URL + token.
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""
