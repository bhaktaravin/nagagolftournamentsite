generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id                 String    @id @default(cuid())
  phone              String    @unique  // mobile phone, used for login
  zipcode            String
  name               String?
  email              String?
  role               Role      @default(USER)
  membershipYear     Int       @default(2025)
  handicap           Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Additional profile fields (matching legacy NAGGA profile)
  homePhone          String?
  mpId              String?    // member profile id / legacy id
  status            String?   @default("Joined")
  initiatedDate     DateTime?
  slacksWaist       Int?
  birthDate         DateTime?
  address           String?
  ghin              String?   // Golf Handicap and Information Network
  memberType        String?
  groupOfInitiation String?
  slacksLength      Int?
  sex               String?
  club              String?   @default("NAGGA")
  level             String?   // A, B, C, etc.
  shirtSize         String?
  shoeSize          String?

  eventRegistrations EventRegistration[]
  handicapHistory    HandicapHistory[]
  adminAuditLogs     AdminAuditLog[]
  eventScores        EventScore[]
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String
  action       String
  resourceType String
  resourceId   String?
  details      Json?
  ip           String?
  createdAt    DateTime @default(now())

  actor Member @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorId])
}

enum Role {
  USER
  ADMIN
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  MOVED_TO_MAIN
}

model HandicapHistory {
  id        String   @id @default(cuid())
  memberId  String
  handicap  Float
  recordedAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Event {
  id                    String    @id @default(cuid())
  title                 String
  description           String?
  date                  DateTime
  location              String
  maxParticipants       Int?
  isPublished           Boolean   @default(true)
  /// e.g. Stroke play, Scramble, Stableford
  format                String?
  /// When online registration closes (optional)
  registrationDeadline  DateTime?
  /// Rules, prizes, format details for players
  tournamentNotes       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  registrations EventRegistration[]
  pairings       EventPairing[]
  scores          EventScore[]
}

model EventPairing {
  id        String   @id @default(cuid())
  eventId   String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event           Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations   EventRegistration[]

  @@index([eventId])
}

model EventScore {
  id        String   @id @default(cuid())
  eventId   String
  memberId  String
  gross     Int?
  net       Float?
  place     Int?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([eventId])
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  memberId  String
  notes     String?
  status    RegistrationStatus @default(REGISTERED)
  /// Handicap flight label (A, B, C, etc.) — set by admin
  flight      String?
  pairingId   String?
  createdAt DateTime @default(now())

  event   Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member  Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pairing EventPairing?  @relation(fields: [pairingId], references: [id], onDelete: SetNull)

  @@unique([eventId, memberId])
  @@index([pairingId])
}
